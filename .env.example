# victorndunda.com — environment template (v21 trust hardening)
# ─────────────────────────────────────────────────────────────────
# The PUBLIC SITE (GitHub Pages, static) needs none of these values.
# The values below define PRODUCTION MODE for the private tooling
# (dashboard / client workspace) as designed in TRUST_BOUNDARIES.md.
#
# Production mode is activated by defining window.VN_TRUST_CONFIG in a
# small script loaded BEFORE /trust-mode.js, e.g. in the page <head>:
#
#   <script>
#     window.VN_TRUST_CONFIG = {
#       mode: 'production',
#       backendUrl:            'https://api.example.com',
#       ownerApiToken:         '<server-issued owner session token>',
#       sessionVerifyEndpoint: 'https://api.example.com/auth/verify'
#     };
#   </script>
#   <script src="/trust-mode.js" defer></script>
#
# If any required value is missing, production mode FAILS CLOSED: gated
# apps render a configuration error instead of silently running as a
# browser-local demo. Never commit real tokens — inject them via your
# hosting platform's encrypted secrets at deploy time.
#
# ── Backend boundary (NOT yet deployed — architecture in IMPLEMENTATION_NOTES.md) ──
VN_BACKEND_URL=https://api.example.com            # Supabase/Firebase/edge API base URL
VN_SESSION_VERIFY_ENDPOINT=/auth/verify           # server-side session verification
VN_OWNER_API_TOKEN=                                # server-issued owner token (secret)
VN_ALLOWED_OWNER_EMAILS=mututandunda@gmail.com     # enforced SERVER-side in production

# ── Payments (placeholders today — see TRUST_BOUNDARIES.md) ──
MPESA_PAYBILL=4071186                              # manual reconciliation path
MPESA_CONSUMER_KEY=                                # Daraja API (only when a real integration exists)
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=
FLUTTERWAVE_SECRET_KEY=                            # only when a real integration exists
FLUTTERWAVE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email delivery (Web3Forms relay today; provider API in production) ──
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_DOMAIN=victorndunda.com

# ── Notifications relay (current public form endpoint) ──
WEB3FORMS_ACCESS_KEY=4bf37d31-374a-4f3e-add6-3d2e36f7b784
